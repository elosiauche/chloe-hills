# Chloe Hills — Environment Variables (EXAMPLE ONLY)
#
# Copy this file to `.env.local` for local development and fill in
# real values there. `.env.local` is gitignored — never commit real
# secrets to the repository.
#
# ── PUBLIC (client-safe) ──────────────────────────────────────────
# Everything below is prefixed VITE_ and is inlined into the browser
# bundle by Vite. Only Firebase's client config belongs here — it
# identifies the project but does not itself authorize access;
# actual protection is enforced by firestore.rules / storage.rules.

VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# ── SERVER-ONLY (set in Netlify dashboard, never VITE_-prefixed) ──
# Read only inside netlify/functions/*.ts via process.env. These
# must never be exposed to the client bundle.

# Firebase Admin SDK (for future server-side Firestore/Auth writes,
# e.g. safely setting a user's role to "admin").
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_REAL_KEY\n-----END PRIVATE KEY-----\n"

# AI provider (planned for a later phase — powers AIService).
AI_PROVIDER_API_KEY=your-ai-provider-api-key

# Payment provider (planned for a later phase — powers PaymentService).
PAYMENT_PROVIDER_SECRET_KEY=your-payment-provider-secret-key
PAYMENT_PROVIDER_PUBLISHABLE_KEY=your-payment-provider-publishable-key

# Email provider (planned for a later phase — order confirmations, etc.)
EMAIL_PROVIDER_API_KEY=your-email-provider-api-key
