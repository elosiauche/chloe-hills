rules_version = '2';

// Chloe Hills — Firestore Security Rules (Phase 0)
//
// Principles enforced:
//   - Customers can only read/write their own user-scoped documents.
//   - Product/category catalog is public-read, admin-write only.
//   - Orders are created by their owner but never mutated by the
//     customer afterward (status/payment changes are admin/server-only).
//   - Admin-only collections and operations require role == "admin"
//     on the caller's own /users/{uid} document.
//
// `isAdmin()` reads the caller's own user doc to check role. This is
// safe because /users/{uid} is only ever writable by the owner for
// non-role fields (see rule below) — role itself is set at signup by
// server-trusted logic (Cloud Function/Netlify Function with Admin
// SDK) in a later phase; until then it defaults to "customer" and
// nothing in these rules lets a customer grant themselves "admin".

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // ---------------------------------------------------------
    // users/{userId}
    // ---------------------------------------------------------
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Customers may create/update their own doc but may NEVER set
      // role themselves — role changes require admin or trusted
      // server-side logic once that exists.
      allow create: if isOwner(userId) && request.resource.data.role == "customer";
      allow update: if isOwner(userId) && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // ---------------------------------------------------------
    // customerProfiles/{userId}
    // ---------------------------------------------------------
    match /customerProfiles/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ---------------------------------------------------------
    // products/{productId} — public catalog, admin-managed
    // ---------------------------------------------------------
    match /products/{productId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------
    // categories/{categoryId} — public catalog, admin-managed
    // ---------------------------------------------------------
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------
    // carts/{userId} — cart id is always the owner's uid
    // ---------------------------------------------------------
    match /carts/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ---------------------------------------------------------
    // wishlists/{userId}
    // ---------------------------------------------------------
    match /wishlists/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ---------------------------------------------------------
    // orders/{orderId} — customer creates and reads their own;
    // only admin (or later, a trusted server function) may update
    // status/payment after creation.
    // ---------------------------------------------------------
    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ---------------------------------------------------------
    // luxuryRequests/{requestId} — customer creates and reads their
    // own submissions; status/internal handling is admin-only.
    // ---------------------------------------------------------
    match /luxuryRequests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;

      // Internal concierge notes — admin only, never customer-readable.
      match /internalNotes/{noteId} {
        allow read, write: if isAdmin();
      }
    }

    // Default deny for anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
